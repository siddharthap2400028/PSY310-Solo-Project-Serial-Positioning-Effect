    </Routine>
  </Routines>
  <Flow>
    <Routine name="instr_text"/>
    <LoopInitiator loopType="TrialHandler" name="word_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'list_id': 1.0, 'word': 'lemon'}, {'list_id': 1.0, 'word': 'rocket'}, {'list_id': 1.0, 'word': 'violin'}, {'list_id': 1.0, 'word': 'camel'}, {'list_id': 1.0, 'word': 'bridge'}, {'list_id': 2.0, 'word': 'helmet'}, {'list_id': 2.0, 'word': 'pencil'}, {'list_id': 2.0, 'word': 'tunnel'}, {'list_id': 2.0, 'word': 'pocket'}, {'list_id': 2.0, 'word': 'anchor'}, {'list_id': 3.0, 'word': 'cactus'}, {'list_id': 3.0, 'word': 'hammer'}, {'list_id': 3.0, 'word': 'marble'}, {'list_id': 3.0, 'word': 'candle'}, {'list_id': 3.0, 'word': 'window'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="words.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="word_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Word_Presentation"/>
    <LoopTerminator name="word_loop"/>
    <Routine name="Recall_Phase"/>
  </Flow>
</PsychoPy2experiment>
